MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=hello@metricvibes.com

# Google
GOOGLE_MAPS_API_KEY=
GA_MEASUREMENT_ID=

# WhatsApp
WHATSAPP_NUMBER=15551234567

# Calendly
CALENDLY_URL=https://calendly.com/metricvibes
