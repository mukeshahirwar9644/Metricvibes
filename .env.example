# MetricVibes Environment Configuration
# Copy this file to .env and update values

# App
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/Metricvibesweb/public

# Database
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=metricvibes
DB_USERNAME=root
DB_PASSWORD=

# Email
